# -----------------------------------------------------------------------------
# CalmCash — backend & database environment template
#
# Copy to `.env` in the repository root and adjust the values:
#   cp .env.example .env
#
# Read by: Docker Compose (POSTGRES_*), the Prisma CLI (DATABASE_URL) and the
# API (`apps/api`). The web app has its own template at `apps/web/.env.example`.
# All values below are local-development placeholders — never commit real secrets.
# -----------------------------------------------------------------------------

# --- Local PostgreSQL container (docker compose) ------------------------------
POSTGRES_USER=calmcash
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=calmcash
# Host port the container is published on (bound to 127.0.0.1 only). 5433 avoids a
# clash with a natively installed PostgreSQL, which usually occupies 5432.
POSTGRES_PORT=5433

# --- Database connection (Prisma CLI + API) -----------------------------------
# Must match the POSTGRES_* values above when using the bundled container.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://calmcash:change-me-local-only@localhost:5433/calmcash

# --- API server ---------------------------------------------------------------
# One of: development | test | production
NODE_ENV=development
# Interface to bind. Use 0.0.0.0 inside containers; localhost for local dev.
API_HOST=localhost
API_PORT=4000
# Comma-separated list of browser origins allowed to call the API (no paths).
CORS_ORIGINS=http://localhost:3000
# Maximum accepted JSON request body size (e.g. 100kb, 1mb).
JSON_BODY_LIMIT=100kb
# One of: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Time allowed for in-flight requests to finish during shutdown.
SHUTDOWN_TIMEOUT_MS=10000

# --- Sessions and the web app (see docs/authentication.md) --------------------
# Origin of the web app, used for links in e-mails. Must be one of CORS_ORIGINS.
# Defaults to the first CORS origin.
# WEB_APP_URL=http://localhost:3000
# Reverse proxies in front of the API whose X-Forwarded-For may be trusted
# (client IPs drive rate limiting). 0 = connect directly; 1 = one load balancer.
TRUST_PROXY_HOPS=0
# Absolute session lifetime, and how long an unused session stays valid.
SESSION_MAX_AGE_DAYS=14
SESSION_IDLE_TIMEOUT_HOURS=72

# --- E-mail delivery (SMTP) ---------------------------------------------------
# Read by the API and the worker with the same rules. Delivery is explicit:
#   mailpit  - local Mailpit catcher only (`pnpm mail:up`, inbox at
#              http://localhost:8025). SMTP_HOST must be localhost, 127.0.0.1,
#              ::1, or mailpit, and SMTP_USER/SMTP_PASSWORD must be empty.
#              Default when NODE_ENV is development or test.
#   smtp     - a real provider. Refused unless NODE_ENV=production; then
#              SMTP_HOST and EMAIL_FROM are required and STARTTLS is enforced
#              unless SMTP_SECURE=true (implicit TLS).
#   disabled - nothing is sent (sign-up e-mails fail with 503).
# Never put real mail credentials in a development .env: the API and the
# worker refuse to start with an external SMTP server outside production.
EMAIL_DELIVERY_MODE=mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Set both or neither.
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="CalmCash <no-reply@calmcash.localhost>"
# Host ports of the Mailpit container (bound to 127.0.0.1 only).
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Receipts -----------------------------------------------------------------
# Private directory for receipt files (JPEG, PNG, WebP, or PDF, up to 10 MB).
# Files are served only to their owner, through the API; never point this at a
# public or web-served folder. Relative paths resolve from the API's working
# directory. Development defaults to .data/receipts (git-ignored). Required in
# production: a persistent volume, backed up together with the database.
# RECEIPT_STORAGE_DIR=.data/receipts

# --- Background worker (apps/worker) -------------------------------------------
# Creates reminders, budget alerts, and monthly summaries and sends notification
# e-mail. Nothing is generated or sent while no worker runs (`pnpm dev` starts
# one; production runs it as a supervised long-running process). All optional:
# WORKER_ID=                          # name in leases/heartbeats (default: host:pid:random)
# WORKER_POLL_INTERVAL_MS=5000        # pause between cycles when idle
# WORKER_BATCH_SIZE=20                # jobs and e-mails claimed per cycle (1-100)
# WORKER_LEASE_MS=120000              # claim lifetime before another worker recovers it
# WORKER_SCHEDULER_INTERVAL_MS=300000 # how often daily reviews are (idempotently) queued
# WORKER_DAILY_REVIEW_HOUR=8          # local hour of each user's daily review
# WORKER_HEALTH_PORT=                 # set to serve GET /health on WORKER_HEALTH_HOST
# WORKER_HEALTH_HOST=127.0.0.1

# --- Integration tests --------------------------------------------------------
# Dedicated database for `pnpm test:integration`. Its tables are wiped by the
# tests, so the name must end in `_test` and differ from DATABASE_URL. It is
# created and migrated automatically on the same PostgreSQL server.
TEST_DATABASE_URL=postgresql://calmcash:change-me-local-only@localhost:5433/calmcash_test

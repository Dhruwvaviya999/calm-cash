// CalmCash database schema.
//
// Conventions (see docs/database-design.md for the full rationale):
// - Tables and columns use snake_case via @@map / @map; Prisma models use PascalCase/camelCase.
// - Primary keys are time-ordered UUIDv7 values generated by Prisma Client.
// - Instants are `timestamptz`; calendar dates (budget windows) are `date`.
// - Money is stored as BIGINT integer minor units (e.g. paise) — never floating point.
// - Currency columns hold ISO 4217 alphabetic codes; supported codes are validated by the API.
// - Integrity rules Prisma cannot express (CHECK constraints) live in the migration SQL.

generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// `investment` and `loan` are kept from Phase 1; new accounts use the other types (API-enforced).
enum AccountType {
  cash
  bank
  savings
  credit_card
  digital_wallet
  investment
  loan
  other

  @@map("account_type")
}

/// Optional accent colour of an account, mapped to design tokens by the web app.
enum AccountColor {
  green
  blue
  amber
  purple
  coral
  slate

  @@map("account_color")
}

enum TransactionType {
  income
  expense
  transfer
  /// Reconciliation: corrects one account's balance by `amount_minor` in `adjustment_direction`.
  balance_adjustment

  @@map("transaction_type")
}

/// Which way a balance adjustment moves the account's signed net position.
enum AdjustmentDirection {
  increase
  decrease

  @@map("adjustment_direction")
}

/// How a payment was made (optional; never on balance adjustments).
enum PaymentMethod {
  cash
  upi
  bank_transfer
  debit_card
  credit_card
  net_banking
  cheque
  digital_wallet
  direct_debit
  other

  @@map("payment_method")
}

enum CategoryKind {
  income
  expense

  @@map("category_kind")
}

enum BudgetPeriod {
  weekly
  monthly
  quarterly
  yearly
  custom

  @@map("budget_period")
}

/// How a recurring schedule repeats; combined with `interval` (every 2 weeks, every 3 months, …).
enum RecurringFrequency {
  weekly
  monthly
  yearly

  @@map("recurring_frequency")
}

/// What the person did with one occurrence of a schedule. Occurrences nobody acted on are not
/// stored: they are pending and follow from the schedule's rule.
/// Where a statement import stands (see docs/database-design.md §3e).
enum ImportBatchStatus {
  mapping
  reviewing
  completed
  cancelled

  @@map("import_batch_status")
}

/// What happened to one staged statement row.
enum ImportRowStatus {
  invalid
  review
  ready
  matched
  imported
  skipped
  failed

  @@map("import_row_status")
}

/// Money out of (`debit`) or into (`credit`) the imported account.
enum StatementDirection {
  debit
  credit

  @@map("statement_direction")
}

enum OccurrenceState {
  /// Still expected, on a later due date.
  postponed
  /// A real transaction was recorded for it (`transaction_id`).
  recorded
  /// The person said it will not happen this time.
  skipped
  /// It fell while the schedule was paused, so it is not owed.
  paused

  @@map("occurrence_state")
}

/// Kinds of notification (packages/shared/src/constants/notifications.ts holds the meaning).
enum NotificationType {
  budget_approaching_limit
  budget_limit_reached
  recurring_payment_upcoming
  recurring_payment_due
  recurring_payment_overdue
  subscription_renewal_upcoming
  monthly_summary_ready
  email_delivery_problem

  @@map("notification_type")
}

/// Channels with delivery records; in-app notifications need none.
enum DeliveryChannel {
  email

  @@map("delivery_channel")
}

/// Where one e-mail delivery stands (independent of the in-app read state).
enum NotificationDeliveryStatus {
  pending
  processing
  sent
  retry_scheduled
  failed
  suppressed

  @@map("notification_delivery_status")
}

/// Where one automation job stands.
enum AutomationJobStatus {
  pending
  processing
  succeeded
  failed
  cancelled
  expired

  @@map("automation_job_status")
}

/// Who wrote an assistant message.
enum AiMessageRole {
  user
  assistant

  @@map("ai_message_role")
}

/// What a single-use e-mail token proves when it is consumed.
enum AuthTokenPurpose {
  email_verification
  password_reset

  @@map("auth_token_purpose")
}

model User {
  id                String    @id @default(uuid(7)) @db.Uuid
  name              String    @db.VarChar(100)
  /// Normalised to lower case before persistence (enforced by a CHECK constraint).
  email             String    @unique @db.VarChar(254)
  /// Argon2id PHC string. Null for users created before authentication existed: they cannot sign
  /// in until a password is set through the password-reset flow. Never leaves the API.
  passwordHash      String?   @map("password_hash") @db.VarChar(255)
  /// When the user proved ownership of `email`. Unverified users cannot sign in.
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(3)
  /// ISO 4217 code used as the default for new accounts and reports.
  preferredCurrency String    @map("preferred_currency") @db.Char(3)
  /// IANA time zone identifier (e.g. "Asia/Kolkata") used for date-based reporting.
  timezone          String    @db.VarChar(64)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  accounts             Account[]
  categories           Category[]
  transactions         Transaction[]
  budgets              Budget[]
  sessions             Session[]
  authTokens           AuthToken[]
  recurringSchedules   RecurringSchedule[]
  scheduledOccurrences ScheduledOccurrence[]
  savingsGoals         SavingsGoal[]
  goalContributions    GoalContribution[]
  statementImports     StatementImport[]
  statementImportRows  StatementImportRow[]
  transactionReceipts  TransactionReceipt[]
  notificationSettings NotificationPreference?
  notifications        Notification[]
  notificationEmails   NotificationDelivery[]
  automationJobs       AutomationJob[]
  aiPreference         AiPreference?
  aiConversations      AiConversation[]
  aiMessages           AiMessage[]
  aiMerchantRules      AiMerchantRule[]
  aiDismissals         AiDismissal[]
  financialScenarios   FinancialScenario[]

  @@map("users")
}

/// A server-side browser session. The cookie carries a random token; only its SHA-256 hash is
/// stored, so a database leak cannot be replayed as a cookie.
model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  /// Hex SHA-256 of the session token held in the cookie.
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  /// Hex SHA-256 of the CSRF token bound to this session.
  csrfTokenHash String    @map("csrf_token_hash") @db.Char(64)
  /// Coarse, non-identifying description such as "Chrome on Windows". No IP addresses are kept.
  deviceLabel   String?   @map("device_label") @db.VarChar(100)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Updated at most every few minutes; drives the idle timeout.
  lastActiveAt  DateTime  @map("last_active_at") @db.Timestamptz(3)
  /// Absolute end of the session, regardless of activity.
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set on logout, explicit revocation, password change, or password reset.
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use token sent by e-mail (verification or password reset). Only its hash is stored.
model AuthToken {
  id         String           @id @default(uuid(7)) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  purpose    AuthTokenPurpose
  /// Hex SHA-256 of the token in the e-mailed link.
  tokenHash  String           @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(3)
  /// Set atomically when the token is used; a consumed token can never be used again.
  consumedAt DateTime?        @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model Account {
  id                  String        @id @default(uuid(7)) @db.Uuid
  userId              String        @map("user_id") @db.Uuid
  /// Not unique: two accounts may share a name, and an archived account's name can be reused.
  name                String        @db.VarChar(100)
  type                AccountType
  currency            String        @db.Char(3)
  /// Signed net position in minor units at the start of `openingBalanceDate`: positive = money
  /// held, negative = money owed (credit cards, overdrafts).
  openingBalanceMinor BigInt        @default(0) @map("opening_balance_minor")
  /// Calendar day, in the owner's time zone, from which transactions count toward the balance.
  openingBalanceDate  DateTime      @map("opening_balance_date") @db.Date
  /// Bank or provider name. Account and card numbers are never stored.
  institution         String?       @db.VarChar(100)
  /// Credit cards only (CHECK constraint): positive limit in minor units of `currency`.
  creditLimitMinor    BigInt?       @map("credit_limit_minor")
  color               AccountColor?
  /// Set while the account is archived: hidden, closed to new activity, history kept.
  archivedAt          DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       Transaction[]       @relation("TransactionAccount")
  incomingTransfers  Transaction[]       @relation("TransactionTransferAccount")
  recurringSchedules RecurringSchedule[]
  statementImports   StatementImport[]

  // "Accounts of a user", optionally by status (active means archived_at IS NULL).
  @@index([userId, archivedAt])
  @@map("accounts")
}

model Category {
  id         String       @id @default(uuid(7)) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  /// Unique per user and kind across the whole tree, so a name always identifies one category.
  name       String       @db.VarChar(50)
  kind       CategoryKind
  /// Top-level category of a subcategory (one level deep, same user and kind; API-enforced).
  parentId   String?      @map("parent_id") @db.Uuid
  /// Set while archived: kept on past transactions and budgets, not offered for new ones.
  archivedAt DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NO ACTION: a top-level category with subcategories cannot be deleted from under them.
  parent             Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction)
  children           Category[]          @relation("CategoryTree")
  transactions       Transaction[]
  budgets            Budget[]
  recurringSchedules RecurringSchedule[]

  @@unique([userId, kind, name])
  @@index([parentId])
  @@map("categories")
}

model Transaction {
  id                  String               @id @default(uuid(7)) @db.Uuid
  userId              String               @map("user_id") @db.Uuid
  /// Source account. For transfers, money leaves this account.
  accountId           String               @map("account_id") @db.Uuid
  type                TransactionType
  /// Always positive, in minor units of `currency`; the direction is defined by `type` (and, for
  /// balance adjustments, by `adjustmentDirection`).
  amountMinor         BigInt               @map("amount_minor")
  currency            String               @db.Char(3)
  /// What the money was for; for balance adjustments, the reason for the correction.
  description         String               @db.VarChar(255)
  /// Counterparty: merchant or recipient of an expense, payer of income.
  merchant            String?              @db.VarChar(120)
  /// Must be null for transfers and balance adjustments (CHECK constraints).
  categoryId          String?              @map("category_id") @db.Uuid
  /// Destination account. Required for transfers and null otherwise (CHECK constraint).
  transferAccountId   String?              @map("transfer_account_id") @db.Uuid
  /// Required for balance adjustments and null otherwise (CHECK constraint).
  adjustmentDirection AdjustmentDirection? @map("adjustment_direction")
  paymentMethod       PaymentMethod?       @map("payment_method")
  notes               String?              @db.VarChar(2000)
  /// Normalised labels (lower case, hyphenated), at most 10 (CHECK constraint).
  tags                String[]             @default([]) @db.VarChar(32)
  /// Client-chosen key of the request that created the row; a retry with the same key returns
  /// this row instead of recording the money twice.
  idempotencyKey      String?              @map("idempotency_key") @db.Uuid
  /// Set while voided: the row is kept for the record but counts toward nothing.
  voidedAt            DateTime?            @map("voided_at") @db.Timestamptz(3)
  voidReason          String?              @map("void_reason") @db.VarChar(500)
  occurredAt          DateTime             @map("occurred_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NO ACTION: an account with history cannot be deleted directly (archive it instead), while
  // deleting the owning user still cascades because the check runs at the end of the statement.
  account           Account              @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: NoAction)
  transferAccount   Account?             @relation("TransactionTransferAccount", fields: [transferAccountId], references: [id], onDelete: NoAction)
  category          Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Set when the transaction was recorded by confirming a scheduled occurrence.
  occurrence        ScheduledOccurrence?
  /// Statement rows confirmed to be this transaction (no new money movement).
  matchedImportRows StatementImportRow[] @relation("ImportRowMatched")
  /// The statement row this transaction was recorded from, if any.
  importedFromRow   StatementImportRow?  @relation("ImportRowImported")
  receipts          TransactionReceipt[]
  /// Statement imports whose balance correction this adjustment is.
  reconciledImports StatementImport[]

  @@unique([userId, idempotencyKey])
  @@index([userId, occurredAt(sort: Desc)])
  @@index([accountId, occurredAt(sort: Desc)])
  @@index([transferAccountId])
  @@index([categoryId])
  @@index([tags], type: Gin)
  @@map("transactions")
}

model Budget {
  id                String       @id @default(uuid(7)) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  name              String       @db.VarChar(100)
  /// Null means the budget covers all expense categories.
  categoryId        String?      @map("category_id") @db.Uuid
  /// Positive spending limit per period, in minor units of `currency`.
  limitMinor        BigInt       @map("limit_minor")
  currency          String       @db.Char(3)
  period            BudgetPeriod
  startDate         DateTime     @map("start_date") @db.Date
  /// Optional for recurring periods; required when `period` is `custom` (CHECK constraint).
  endDate           DateTime?    @map("end_date") @db.Date
  description       String?      @db.VarChar(500)
  /// In-app alerts in basis points of the limit, ascending, at most three (CHECK constraint).
  alertThresholdsBp Int[]        @default([8000]) @map("alert_thresholds_bp")
  /// Set while archived: kept with its history, left out of lists and summaries.
  archivedAt        DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NO ACTION: deleting a category must not silently widen a budget to "all categories".
  category Category? @relation(fields: [categoryId], references: [id], onDelete: NoAction)

  @@index([userId])
  @@index([categoryId])
  @@map("budgets")
}

/// A rule describing expected income or spending (salary, rent, a subscription). It is a plan:
/// money only moves when the person confirms an occurrence, which records a real transaction.
model RecurringSchedule {
  id                 String             @id @default(uuid(7)) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  name               String             @db.VarChar(100)
  /// `income` or `expense` only (CHECK constraint).
  type               TransactionType
  /// Expected amount per occurrence, positive, in minor units of `currency`.
  amountMinor        BigInt             @map("amount_minor")
  currency           String             @db.Char(3)
  /// Usual account (same currency, API-enforced); may also be chosen when recording.
  accountId          String?            @map("account_id") @db.Uuid
  categoryId         String?            @map("category_id") @db.Uuid
  merchant           String?            @db.VarChar(120)
  paymentMethod      PaymentMethod?     @map("payment_method")
  notes              String?            @db.VarChar(2000)
  frequency          RecurringFrequency
  interval           Int                @default(1) @db.SmallInt
  /// The first occurrence (the anchor): later dates follow its weekday or day of the month.
  startDate          DateTime           @map("start_date") @db.Date
  endDate            DateTime?          @map("end_date") @db.Date
  reminderDays       Int?               @map("reminder_days") @db.SmallInt
  /// Cursor: the earliest occurrence not yet recorded, skipped, or passed over (null when none is
  /// left). Maintained by every write while it holds the schedule's row lock.
  nextOccurrenceDate DateTime?          @map("next_occurrence_date") @db.Date
  isSubscription     Boolean            @default(false) @map("is_subscription")
  pausedAt           DateTime?          @map("paused_at") @db.Timestamptz(3)
  /// Subscriptions only: marked cancelled (an end date is then set; CHECK constraint).
  cancelledAt        DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  archivedAt         DateTime?          @map("archived_at") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NO ACTION: accounts and categories are archived, never deleted, while schedules use them.
  account     Account?              @relation(fields: [accountId], references: [id], onDelete: NoAction)
  category    Category?             @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  occurrences ScheduledOccurrence[]

  @@index([userId, archivedAt])
  @@index([accountId])
  @@index([categoryId])
  @@map("recurring_schedules")
}

/// One occurrence of a schedule that the person acted on. Its identity is the schedule plus the
/// date the rule puts it on (`scheduled_date`), so the same cycle can never exist twice.
model ScheduledOccurrence {
  id            String          @id @default(uuid(7)) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  scheduleId    String          @map("schedule_id") @db.Uuid
  scheduledDate DateTime        @map("scheduled_date") @db.Date
  /// Equals `scheduled_date` unless postponed (never earlier; CHECK constraint).
  dueDate       DateTime        @map("due_date") @db.Date
  state         OccurrenceState
  /// The real transaction; present exactly when `state` is `recorded` (CHECK constraint).
  transactionId String?         @unique @map("transaction_id") @db.Uuid
  /// When it was recorded, skipped, or passed over; null while postponed.
  resolvedAt    DateTime?       @map("resolved_at") @db.Timestamptz(3)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule    RecurringSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  // NO ACTION: transactions are voided, never deleted.
  transaction Transaction?      @relation(fields: [transactionId], references: [id], onDelete: NoAction)

  @@unique([scheduleId, scheduledDate])
  @@index([userId, dueDate])
  @@map("scheduled_occurrences")
}

/// Something the person is saving towards. Progress is the sum of its contributions (planning
/// allocations), which never change an account balance.
model SavingsGoal {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  /// Positive target in minor units of `currency`.
  targetMinor BigInt    @map("target_minor")
  currency    String    @db.Char(3)
  targetDate  DateTime? @map("target_date") @db.Date
  pausedAt    DateTime? @map("paused_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([userId, archivedAt])
  @@map("savings_goals")
}

/// A planning allocation towards a goal: money set aside (positive) or taken back (negative). It
/// is not a transaction and never moves money between accounts.
model GoalContribution {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  goalId        String   @map("goal_id") @db.Uuid
  /// Signed, never zero, in minor units of the goal's currency.
  amountMinor   BigInt   @map("amount_minor")
  contributedOn DateTime @map("contributed_on") @db.Date
  note          String?  @db.VarChar(200)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, contributedOn])
  @@map("goal_contributions")
}

/// One statement upload for one account: its file structure, the confirmed column mapping, the
/// statement's own period and balances (when the person gives them), and the reconciliation result.
/// The file itself is never stored; only bounded, normalised rows are staged.
model StatementImport {
  id                            String            @id @default(uuid(7)) @db.Uuid
  userId                        String            @map("user_id") @db.Uuid
  accountId                     String            @map("account_id") @db.Uuid
  /// Display label only (sanitised, bounded); never used for storage.
  fileName                      String            @map("file_name") @db.VarChar(120)
  format                        String            @default("csv") @db.VarChar(10)
  delimiter                     String            @db.VarChar(1)
  hasHeaderRow                  Boolean           @map("has_header_row")
  /// Always the account's currency at upload; amounts are never converted.
  currency                      String            @db.Char(3)
  status                        ImportBatchStatus @default(mapping)
  /// Header names (or "Column n"); bounded by CHECK constraint.
  columns                       String[]          @default([]) @db.VarChar(500)
  /// Confirmed mapping and parsing settings (validated with Zod on every read).
  settings                      Json?
  periodStart                   DateTime?         @map("period_start") @db.Date
  periodEnd                     DateTime?         @map("period_end") @db.Date
  openingBalanceMinor           BigInt?           @map("opening_balance_minor")
  closingBalanceMinor           BigInt?           @map("closing_balance_minor")
  reconciledAt                  DateTime?         @map("reconciled_at") @db.Timestamptz(3)
  reconciliationDifferenceMinor BigInt?           @map("reconciliation_difference_minor")
  adjustmentTransactionId       String?           @map("adjustment_transaction_id") @db.Uuid
  completedAt                   DateTime?         @map("completed_at") @db.Timestamptz(3)
  cancelledAt                   DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  createdAt                     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NO ACTION: accounts and transactions are archived or voided, never deleted.
  account               Account              @relation(fields: [accountId], references: [id], onDelete: NoAction)
  adjustmentTransaction Transaction?         @relation(fields: [adjustmentTransactionId], references: [id], onDelete: NoAction)
  rows                  StatementImportRow[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([accountId])
  @@map("statement_imports")
}

/// One data row of a statement, staged for review. Raw cells are kept only while the import is
/// open (to re-read them with new settings) and cleared when it is completed or cancelled.
model StatementImportRow {
  id                    String              @id @default(uuid(7)) @db.Uuid
  userId                String              @map("user_id") @db.Uuid
  batchId               String              @map("batch_id") @db.Uuid
  /// Line of the row in the file.
  rowNumber             Int                 @map("row_number")
  cells                 String[]            @default([]) @db.VarChar(500)
  status                ImportRowStatus
  occurredOn            DateTime?           @map("occurred_on") @db.Date
  /// Positive; the direction says which way the money moved.
  amountMinor           BigInt?             @map("amount_minor")
  direction             StatementDirection?
  description           String              @default("") @db.VarChar(500)
  reference             String?             @db.VarChar(500)
  counterparty          String?             @db.VarChar(500)
  /// Normalised description used to recognise the same entry again (lower case, no digits).
  descriptionKey        String?             @map("description_key") @db.VarChar(120)
  problems              Json                @default("[]")
  warnings              Json                @default("[]")
  /// The transaction the person will record (validated with Zod on every read).
  proposal              Json?
  duplicates            Json                @default("[]")
  duplicateDismissed    Boolean             @default(false) @map("duplicate_dismissed")
  matchedTransactionId  String?             @map("matched_transaction_id") @db.Uuid
  /// Unique: a transaction is recorded from at most one row.
  importedTransactionId String?             @unique @map("imported_transaction_id") @db.Uuid
  error                 String?             @db.VarChar(500)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch               StatementImport @relation(fields: [batchId], references: [id], onDelete: Cascade)
  matchedTransaction  Transaction?    @relation("ImportRowMatched", fields: [matchedTransactionId], references: [id], onDelete: NoAction)
  importedTransaction Transaction?    @relation("ImportRowImported", fields: [importedTransactionId], references: [id], onDelete: NoAction)

  @@unique([batchId, rowNumber])
  /// Within one statement, a transaction is matched by at most one row.
  @@unique([batchId, matchedTransactionId])
  @@index([batchId, status])
  @@index([userId, occurredOn])
  @@index([matchedTransactionId])
  @@map("statement_import_rows")
}

/// A receipt file attached to a transaction. The file lives in private storage under a random key;
/// only metadata is in the database. Receipts never affect balances.
model TransactionReceipt {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  /// Random, server-generated; never derived from the file name and never sent to clients.
  storageKey    String   @unique @map("storage_key") @db.Char(32)
  fileName      String   @map("file_name") @db.VarChar(120)
  /// Determined from the file's signature.
  contentType   String   @map("content_type") @db.VarChar(32)
  sizeBytes     Int      @map("size_bytes")
  sha256        String   @db.Char(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NO ACTION: transactions are voided, never deleted.
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: NoAction)

  @@index([transactionId])
  @@map("transaction_receipts")
}

/// A person's notification choices. No row means the documented defaults (in-app on, e-mail off,
/// three days' notice); the row is created on the first change.
model NotificationPreference {
  userId                    String   @id @map("user_id") @db.Uuid
  budgetAlertsInApp         Boolean  @default(true) @map("budget_alerts_in_app")
  budgetAlertsEmail         Boolean  @default(false) @map("budget_alerts_email")
  upcomingPaymentsInApp     Boolean  @default(true) @map("upcoming_payments_in_app")
  upcomingPaymentsEmail     Boolean  @default(false) @map("upcoming_payments_email")
  overduePaymentsInApp      Boolean  @default(true) @map("overdue_payments_in_app")
  overduePaymentsEmail      Boolean  @default(false) @map("overdue_payments_email")
  subscriptionRenewalsInApp Boolean  @default(true) @map("subscription_renewals_in_app")
  subscriptionRenewalsEmail Boolean  @default(false) @map("subscription_renewals_email")
  monthlySummaryInApp       Boolean  @default(true) @map("monthly_summary_in_app")
  monthlySummaryEmail       Boolean  @default(false) @map("monthly_summary_email")
  /// Days of notice before a bill or expected income is due: 1, 3, or 7 (CHECK constraint).
  paymentLeadDays           Int      @default(3) @map("payment_lead_days") @db.SmallInt
  /// Days of notice before a subscription renews: 1, 3, or 7 (CHECK constraint).
  subscriptionLeadDays      Int      @default(3) @map("subscription_lead_days") @db.SmallInt
  /// Also remind about expected income, not only bills.
  includeRecurringIncome    Boolean  @default(false) @map("include_recurring_income")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// One logical notification. Its identity is the user plus `dedupe_key` (for example a budget,
/// its period, its limit, and the threshold), so repeating the job that creates it never creates
/// it twice. Title and body are plain text written by the API; `target` holds identifiers only.
model Notification {
  id          String           @id @default(uuid(7)) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  type        NotificationType
  dedupeKey   String           @map("dedupe_key") @db.VarChar(200)
  title       String           @db.VarChar(160)
  body        String           @db.VarChar(1000)
  /// Navigation target (validated with Zod on every read); never a URL.
  target      Json?
  /// Shown in the notification center: the person's in-app choice when it was created. False
  /// when it exists only to be e-mailed.
  inApp       Boolean          @map("in_app")
  readAt      DateTime?        @map("read_at") @db.Timestamptz(3)
  dismissedAt DateTime?        @map("dismissed_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

/// One attempt-tracked delivery of a notification outside the app (e-mail). Claimed by workers
/// with `FOR UPDATE SKIP LOCKED` and a lease, retried with backoff, never deleted on failure.
model NotificationDelivery {
  id               String                     @id @default(uuid(7)) @db.Uuid
  notificationId   String                     @map("notification_id") @db.Uuid
  userId           String                     @map("user_id") @db.Uuid
  channel          DeliveryChannel            @default(email)
  status           NotificationDeliveryStatus @default(pending)
  attempts         Int                        @default(0)
  maxAttempts      Int                        @default(5) @map("max_attempts")
  nextAttemptAt    DateTime                   @map("next_attempt_at") @db.Timestamptz(3)
  /// After this instant the message is no longer worth sending (e.g. the payment is already due).
  expiresAt        DateTime?                  @map("expires_at") @db.Timestamptz(3)
  /// Worker holding the lease while `processing`.
  lockedBy         String?                    @map("locked_by") @db.VarChar(100)
  lockedUntil      DateTime?                  @map("locked_until") @db.Timestamptz(3)
  /// Sanitised classification of the last failure or suppression (never a provider message).
  lastErrorCode    String?                    @map("last_error_code") @db.VarChar(40)
  /// An attempt ended without knowing whether the mail server accepted the message.
  outcomeUncertain Boolean                    @default(false) @map("outcome_uncertain")
  sentAt           DateTime?                  @map("sent_at") @db.Timestamptz(3)
  completedAt      DateTime?                  @map("completed_at") @db.Timestamptz(3)
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@index([userId, status])
  @@index([completedAt])
  @@map("notification_deliveries")
}

/// Durable background work: business events (a budget to re-check) and scheduled reviews. Claimed
/// with `FOR UPDATE SKIP LOCKED` and a lease; an expired lease is recovered by any worker.
model AutomationJob {
  id            String              @id @default(uuid(7)) @db.Uuid
  /// `budget_evaluation`, `daily_review`, or `maintenance`; read as text and validated with Zod,
  /// so a kind this deployment does not know fails the job instead of the worker.
  kind          String              @db.VarChar(40)
  userId        String?             @map("user_id") @db.Uuid
  /// "Never twice": a scheduled run (one daily review per user and local day) keeps its key.
  dedupeKey     String?             @unique @map("dedupe_key") @db.VarChar(200)
  /// "At most one waiting": set while pending and cleared when claimed, so events that arrive
  /// while a job waits are absorbed by it, and events during a run queue exactly one more.
  coalesceKey   String?             @unique @map("coalesce_key") @db.VarChar(200)
  /// Versioned, identifiers only (validated with Zod when claimed).
  payload       Json
  status        AutomationJobStatus @default(pending)
  runAt         DateTime            @map("run_at") @db.Timestamptz(3)
  /// Not run after this instant (marked `expired`), so missed work is never replayed blindly.
  expiresAt     DateTime?           @map("expires_at") @db.Timestamptz(3)
  attempts      Int                 @default(0)
  maxAttempts   Int                 @default(5) @map("max_attempts")
  lockedBy      String?             @map("locked_by") @db.VarChar(100)
  lockedUntil   DateTime?           @map("locked_until") @db.Timestamptz(3)
  lastErrorCode String?             @map("last_error_code") @db.VarChar(40)
  completedAt   DateTime?           @map("completed_at") @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([userId])
  @@index([completedAt])
  @@map("automation_jobs")
}

/// A running worker process, refreshed while it works. Diagnostics only (Settings shows whether
/// reminders are being processed); never used for locking.
model WorkerHeartbeat {
  id         String   @id @db.VarChar(100)
  startedAt  DateTime @map("started_at") @db.Timestamptz(3)
  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz(3)

  @@index([lastSeenAt])
  @@map("worker_heartbeats")
}

/// One fixed-window counter of an abuse limit (sign-in, recovery, uploads, AI, intelligence),
/// shared by every API instance. `key` is a SHA-256 hash of the limiter name and its subject
/// (IP, normalised e-mail, or user), so no address is stored. Expired rows are deleted by the
/// worker's maintenance job; a row past `reset_at` simply starts a new window.
model RateLimitCounter {
  key     String   @id @db.Char(64)
  hits    Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(3)

  @@index([resetAt])
  @@map("rate_limit_counters")
}

/// A person's AI switch. No row means AI features are on (they run on the local model only).
model AiPreference {
  userId    String   @id @map("user_id") @db.Uuid
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_preferences")
}

/// An assistant conversation. History is for reading back only — answers always re-fetch data.
model AiConversation {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("ai_conversations")
}

/// One visible message. Assistant messages keep the blocks shown (figures as of `created_at`),
/// never prompts, hidden reasoning, or raw model output.
model AiMessage {
  id             String        @id @default(uuid(7)) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  role           AiMessageRole
  content        String        @db.VarChar(4000)
  /// Validated answer blocks and follow-up questions (Zod on every read).
  blocks         Json          @default("[]")
  followUps      String[]      @default([]) @map("follow_ups") @db.VarChar(160)
  outcome        String?       @db.VarChar(20)
  narrative      String?       @db.VarChar(10)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId])
  @@map("ai_messages")
}

/// A merchant name the person confirmed for a description pattern, reused for their later
/// transactions only (never shared across users).
model AiMerchantRule {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  patternKey String   @map("pattern_key") @db.VarChar(120)
  merchant   String   @db.VarChar(120)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, patternKey])
  @@map("ai_merchant_rules")
}

/// Something the person rejected or dismissed (a category for a transaction, a merchant
/// suggestion, a recurring candidate, an insight), so it is not offered again unchanged. Since
/// Phase 11 also a financial recommendation the person dismissed (`value` = `dismissed`) or marked
/// as reviewed (`value` = `reviewed`).
model AiDismissal {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  kind       String   @db.VarChar(30)
  subjectKey String   @map("subject_key") @db.VarChar(200)
  value      String   @default("") @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, subjectKey, value])
  @@map("ai_dismissals")
}

/// A what-if scenario (Phase 11): the person's hypothetical assumptions only. Results are
/// recalculated from the ledger every time it runs and are never stored, so an old result can
/// never be shown as current. Nothing here is a transaction, schedule, budget, or contribution.
model FinancialScenario {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.VarChar(80)
  currency    String   @db.Char(3)
  /// 30, 60, 90, 180, or 365 (CHECK constraint).
  horizonDays Int      @map("horizon_days")
  /// Validated scenario adjustments (Zod on every read); identifiers are re-checked on every run.
  assumptions Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt(sort: Desc)])
  @@map("financial_scenarios")
}

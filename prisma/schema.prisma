// CalmCash database schema.
//
// Conventions (see docs/database-design.md for the full rationale):
// - Tables and columns use snake_case via @@map / @map; Prisma models use PascalCase/camelCase.
// - Primary keys are time-ordered UUIDv7 values generated by Prisma Client.
// - Instants are `timestamptz`; calendar dates (budget windows) are `date`.
// - Money is stored as BIGINT integer minor units (e.g. paise) — never floating point.
// - Currency columns hold ISO 4217 alphabetic codes; supported codes are validated by the API.
// - Integrity rules Prisma cannot express (CHECK constraints) live in the migration SQL.

generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// `investment` and `loan` are kept from Phase 1; new accounts use the other types (API-enforced).
enum AccountType {
  cash
  bank
  savings
  credit_card
  digital_wallet
  investment
  loan
  other

  @@map("account_type")
}

/// Optional accent colour of an account, mapped to design tokens by the web app.
enum AccountColor {
  green
  blue
  amber
  purple
  coral
  slate

  @@map("account_color")
}

enum TransactionType {
  income
  expense
  transfer
  /// Reconciliation: corrects one account's balance by `amount_minor` in `adjustment_direction`.
  balance_adjustment

  @@map("transaction_type")
}

/// Which way a balance adjustment moves the account's signed net position.
enum AdjustmentDirection {
  increase
  decrease

  @@map("adjustment_direction")
}

/// How a payment was made (optional; never on balance adjustments).
enum PaymentMethod {
  cash
  upi
  bank_transfer
  debit_card
  credit_card
  net_banking
  cheque
  digital_wallet
  direct_debit
  other

  @@map("payment_method")
}

enum CategoryKind {
  income
  expense

  @@map("category_kind")
}

enum BudgetPeriod {
  weekly
  monthly
  quarterly
  yearly
  custom

  @@map("budget_period")
}

/// How a recurring schedule repeats; combined with `interval` (every 2 weeks, every 3 months, …).
enum RecurringFrequency {
  weekly
  monthly
  yearly

  @@map("recurring_frequency")
}

/// What the person did with one occurrence of a schedule. Occurrences nobody acted on are not
/// stored: they are pending and follow from the schedule's rule.
enum OccurrenceState {
  /// Still expected, on a later due date.
  postponed
  /// A real transaction was recorded for it (`transaction_id`).
  recorded
  /// The person said it will not happen this time.
  skipped
  /// It fell while the schedule was paused, so it is not owed.
  paused

  @@map("occurrence_state")
}

/// What a single-use e-mail token proves when it is consumed.
enum AuthTokenPurpose {
  email_verification
  password_reset

  @@map("auth_token_purpose")
}

model User {
  id                String    @id @default(uuid(7)) @db.Uuid
  name              String    @db.VarChar(100)
  /// Normalised to lower case before persistence (enforced by a CHECK constraint).
  email             String    @unique @db.VarChar(254)
  /// Argon2id PHC string. Null for users created before authentication existed: they cannot sign
  /// in until a password is set through the password-reset flow. Never leaves the API.
  passwordHash      String?   @map("password_hash") @db.VarChar(255)
  /// When the user proved ownership of `email`. Unverified users cannot sign in.
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(3)
  /// ISO 4217 code used as the default for new accounts and reports.
  preferredCurrency String    @map("preferred_currency") @db.Char(3)
  /// IANA time zone identifier (e.g. "Asia/Kolkata") used for date-based reporting.
  timezone          String    @db.VarChar(64)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  accounts             Account[]
  categories           Category[]
  transactions         Transaction[]
  budgets              Budget[]
  sessions             Session[]
  authTokens           AuthToken[]
  recurringSchedules   RecurringSchedule[]
  scheduledOccurrences ScheduledOccurrence[]
  savingsGoals         SavingsGoal[]
  goalContributions    GoalContribution[]

  @@map("users")
}

/// A server-side browser session. The cookie carries a random token; only its SHA-256 hash is
/// stored, so a database leak cannot be replayed as a cookie.
model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  /// Hex SHA-256 of the session token held in the cookie.
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  /// Hex SHA-256 of the CSRF token bound to this session.
  csrfTokenHash String    @map("csrf_token_hash") @db.Char(64)
  /// Coarse, non-identifying description such as "Chrome on Windows". No IP addresses are kept.
  deviceLabel   String?   @map("device_label") @db.VarChar(100)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Updated at most every few minutes; drives the idle timeout.
  lastActiveAt  DateTime  @map("last_active_at") @db.Timestamptz(3)
  /// Absolute end of the session, regardless of activity.
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set on logout, explicit revocation, password change, or password reset.
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use token sent by e-mail (verification or password reset). Only its hash is stored.
model AuthToken {
  id         String           @id @default(uuid(7)) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  purpose    AuthTokenPurpose
  /// Hex SHA-256 of the token in the e-mailed link.
  tokenHash  String           @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(3)
  /// Set atomically when the token is used; a consumed token can never be used again.
  consumedAt DateTime?        @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model Account {
  id                  String        @id @default(uuid(7)) @db.Uuid
  userId              String        @map("user_id") @db.Uuid
  /// Not unique: two accounts may share a name, and an archived account's name can be reused.
  name                String        @db.VarChar(100)
  type                AccountType
  currency            String        @db.Char(3)
  /// Signed net position in minor units at the start of `openingBalanceDate`: positive = money
  /// held, negative = money owed (credit cards, overdrafts).
  openingBalanceMinor BigInt        @default(0) @map("opening_balance_minor")
  /// Calendar day, in the owner's time zone, from which transactions count toward the balance.
  openingBalanceDate  DateTime      @map("opening_balance_date") @db.Date
  /// Bank or provider name. Account and card numbers are never stored.
  institution         String?       @db.VarChar(100)
  /// Credit cards only (CHECK constraint): positive limit in minor units of `currency`.
  creditLimitMinor    BigInt?       @map("credit_limit_minor")
  color               AccountColor?
  /// Set while the account is archived: hidden, closed to new activity, history kept.
  archivedAt          DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       Transaction[]       @relation("TransactionAccount")
  incomingTransfers  Transaction[]       @relation("TransactionTransferAccount")
  recurringSchedules RecurringSchedule[]

  // "Accounts of a user", optionally by status (active means archived_at IS NULL).
  @@index([userId, archivedAt])
  @@map("accounts")
}

model Category {
  id         String       @id @default(uuid(7)) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  /// Unique per user and kind across the whole tree, so a name always identifies one category.
  name       String       @db.VarChar(50)
  kind       CategoryKind
  /// Top-level category of a subcategory (one level deep, same user and kind; API-enforced).
  parentId   String?      @map("parent_id") @db.Uuid
  /// Set while archived: kept on past transactions and budgets, not offered for new ones.
  archivedAt DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NO ACTION: a top-level category with subcategories cannot be deleted from under them.
  parent             Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction)
  children           Category[]          @relation("CategoryTree")
  transactions       Transaction[]
  budgets            Budget[]
  recurringSchedules RecurringSchedule[]

  @@unique([userId, kind, name])
  @@index([parentId])
  @@map("categories")
}

model Transaction {
  id                  String               @id @default(uuid(7)) @db.Uuid
  userId              String               @map("user_id") @db.Uuid
  /// Source account. For transfers, money leaves this account.
  accountId           String               @map("account_id") @db.Uuid
  type                TransactionType
  /// Always positive, in minor units of `currency`; the direction is defined by `type` (and, for
  /// balance adjustments, by `adjustmentDirection`).
  amountMinor         BigInt               @map("amount_minor")
  currency            String               @db.Char(3)
  /// What the money was for; for balance adjustments, the reason for the correction.
  description         String               @db.VarChar(255)
  /// Counterparty: merchant or recipient of an expense, payer of income.
  merchant            String?              @db.VarChar(120)
  /// Must be null for transfers and balance adjustments (CHECK constraints).
  categoryId          String?              @map("category_id") @db.Uuid
  /// Destination account. Required for transfers and null otherwise (CHECK constraint).
  transferAccountId   String?              @map("transfer_account_id") @db.Uuid
  /// Required for balance adjustments and null otherwise (CHECK constraint).
  adjustmentDirection AdjustmentDirection? @map("adjustment_direction")
  paymentMethod       PaymentMethod?       @map("payment_method")
  notes               String?              @db.VarChar(2000)
  /// Normalised labels (lower case, hyphenated), at most 10 (CHECK constraint).
  tags                String[]             @default([]) @db.VarChar(32)
  /// Client-chosen key of the request that created the row; a retry with the same key returns
  /// this row instead of recording the money twice.
  idempotencyKey      String?              @map("idempotency_key") @db.Uuid
  /// Set while voided: the row is kept for the record but counts toward nothing.
  voidedAt            DateTime?            @map("voided_at") @db.Timestamptz(3)
  voidReason          String?              @map("void_reason") @db.VarChar(500)
  occurredAt          DateTime             @map("occurred_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NO ACTION: an account with history cannot be deleted directly (archive it instead), while
  // deleting the owning user still cascades because the check runs at the end of the statement.
  account         Account              @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: NoAction)
  transferAccount Account?             @relation("TransactionTransferAccount", fields: [transferAccountId], references: [id], onDelete: NoAction)
  category        Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Set when the transaction was recorded by confirming a scheduled occurrence.
  occurrence      ScheduledOccurrence?

  @@unique([userId, idempotencyKey])
  @@index([userId, occurredAt(sort: Desc)])
  @@index([accountId, occurredAt(sort: Desc)])
  @@index([transferAccountId])
  @@index([categoryId])
  @@index([tags], type: Gin)
  @@map("transactions")
}

model Budget {
  id                String       @id @default(uuid(7)) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  name              String       @db.VarChar(100)
  /// Null means the budget covers all expense categories.
  categoryId        String?      @map("category_id") @db.Uuid
  /// Positive spending limit per period, in minor units of `currency`.
  limitMinor        BigInt       @map("limit_minor")
  currency          String       @db.Char(3)
  period            BudgetPeriod
  startDate         DateTime     @map("start_date") @db.Date
  /// Optional for recurring periods; required when `period` is `custom` (CHECK constraint).
  endDate           DateTime?    @map("end_date") @db.Date
  description       String?      @db.VarChar(500)
  /// In-app alerts in basis points of the limit, ascending, at most three (CHECK constraint).
  alertThresholdsBp Int[]        @default([8000]) @map("alert_thresholds_bp")
  /// Set while archived: kept with its history, left out of lists and summaries.
  archivedAt        DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NO ACTION: deleting a category must not silently widen a budget to "all categories".
  category Category? @relation(fields: [categoryId], references: [id], onDelete: NoAction)

  @@index([userId])
  @@index([categoryId])
  @@map("budgets")
}

/// A rule describing expected income or spending (salary, rent, a subscription). It is a plan:
/// money only moves when the person confirms an occurrence, which records a real transaction.
model RecurringSchedule {
  id                 String             @id @default(uuid(7)) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  name               String             @db.VarChar(100)
  /// `income` or `expense` only (CHECK constraint).
  type               TransactionType
  /// Expected amount per occurrence, positive, in minor units of `currency`.
  amountMinor        BigInt             @map("amount_minor")
  currency           String             @db.Char(3)
  /// Usual account (same currency, API-enforced); may also be chosen when recording.
  accountId          String?            @map("account_id") @db.Uuid
  categoryId         String?            @map("category_id") @db.Uuid
  merchant           String?            @db.VarChar(120)
  paymentMethod      PaymentMethod?     @map("payment_method")
  notes              String?            @db.VarChar(2000)
  frequency          RecurringFrequency
  interval           Int                @default(1) @db.SmallInt
  /// The first occurrence (the anchor): later dates follow its weekday or day of the month.
  startDate          DateTime           @map("start_date") @db.Date
  endDate            DateTime?          @map("end_date") @db.Date
  reminderDays       Int?               @map("reminder_days") @db.SmallInt
  /// Cursor: the earliest occurrence not yet recorded, skipped, or passed over (null when none is
  /// left). Maintained by every write while it holds the schedule's row lock.
  nextOccurrenceDate DateTime?          @map("next_occurrence_date") @db.Date
  isSubscription     Boolean            @default(false) @map("is_subscription")
  pausedAt           DateTime?          @map("paused_at") @db.Timestamptz(3)
  /// Subscriptions only: marked cancelled (an end date is then set; CHECK constraint).
  cancelledAt        DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  archivedAt         DateTime?          @map("archived_at") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NO ACTION: accounts and categories are archived, never deleted, while schedules use them.
  account     Account?              @relation(fields: [accountId], references: [id], onDelete: NoAction)
  category    Category?             @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  occurrences ScheduledOccurrence[]

  @@index([userId, archivedAt])
  @@index([accountId])
  @@index([categoryId])
  @@map("recurring_schedules")
}

/// One occurrence of a schedule that the person acted on. Its identity is the schedule plus the
/// date the rule puts it on (`scheduled_date`), so the same cycle can never exist twice.
model ScheduledOccurrence {
  id            String          @id @default(uuid(7)) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  scheduleId    String          @map("schedule_id") @db.Uuid
  scheduledDate DateTime        @map("scheduled_date") @db.Date
  /// Equals `scheduled_date` unless postponed (never earlier; CHECK constraint).
  dueDate       DateTime        @map("due_date") @db.Date
  state         OccurrenceState
  /// The real transaction; present exactly when `state` is `recorded` (CHECK constraint).
  transactionId String?         @unique @map("transaction_id") @db.Uuid
  /// When it was recorded, skipped, or passed over; null while postponed.
  resolvedAt    DateTime?       @map("resolved_at") @db.Timestamptz(3)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule    RecurringSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  // NO ACTION: transactions are voided, never deleted.
  transaction Transaction?      @relation(fields: [transactionId], references: [id], onDelete: NoAction)

  @@unique([scheduleId, scheduledDate])
  @@index([userId, dueDate])
  @@map("scheduled_occurrences")
}

/// Something the person is saving towards. Progress is the sum of its contributions (planning
/// allocations), which never change an account balance.
model SavingsGoal {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  /// Positive target in minor units of `currency`.
  targetMinor BigInt    @map("target_minor")
  currency    String    @db.Char(3)
  targetDate  DateTime? @map("target_date") @db.Date
  pausedAt    DateTime? @map("paused_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([userId, archivedAt])
  @@map("savings_goals")
}

/// A planning allocation towards a goal: money set aside (positive) or taken back (negative). It
/// is not a transaction and never moves money between accounts.
model GoalContribution {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  goalId        String   @map("goal_id") @db.Uuid
  /// Signed, never zero, in minor units of the goal's currency.
  amountMinor   BigInt   @map("amount_minor")
  contributedOn DateTime @map("contributed_on") @db.Date
  note          String?  @db.VarChar(200)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, contributedOn])
  @@map("goal_contributions")
}

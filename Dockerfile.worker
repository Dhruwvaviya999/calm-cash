FROM node:24-bookworm-slim AS build
WORKDIR /app
RUN npm install --global pnpm@11.21.0

# The daemon needs the workspace root: its bundle imports API automation and shared contracts.
# .dockerignore excludes credentials, receipt files, dependencies, and generated build output.
COPY . .
RUN pnpm install --frozen-lockfile --filter . --filter @calmcash/worker...
RUN pnpm --filter @calmcash/worker build

FROM node:24-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    WORKER_HEALTH_HOST=0.0.0.0 \
    WORKER_HEALTH_PORT=8080
COPY --from=build --chown=node:node /app /app
USER node
CMD ["node", "--enable-source-maps", "apps/worker/dist/main.js"]

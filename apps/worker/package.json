{
  "name": "@calmcash/worker",
  "version": "0.1.0",
  "private": true,
  "description": "CalmCash background worker: notifications, reminders, summaries, and e-mail delivery.",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/main.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "status": "node --env-file-if-exists=../../.env --import tsx src/cli.ts status",
    "requeue-failed": "node --env-file-if-exists=../../.env --import tsx src/cli.ts requeue-failed",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@calmcash/api": "workspace:*",
    "@calmcash/shared": "workspace:*",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "nodemailer": "~10.0.16",
    "pino": "^10.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}

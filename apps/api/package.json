{
  "name": "@calmcash/api",
  "version": "0.1.0",
  "private": true,
  "description": "CalmCash REST API (Express + TypeScript).",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "exports": {
    "./automation": "./src/automation/index.ts"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:ai-smoke": "vitest run --config vitest.ai-smoke.config.ts",
    "seed:synthetic": "node --env-file-if-exists=../../.env --import tsx src/cli/seed-synthetic.ts",
    "receipts:audit": "node --env-file-if-exists=../../.env --import tsx src/cli/receipts-audit.ts"
  },
  "dependencies": {
    "@calmcash/shared": "workspace:*",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.5",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "nodemailer": "~10.1.7",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}

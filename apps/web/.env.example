# -----------------------------------------------------------------------------
# CalmCash web app — environment template
#
# Copy to `apps/web/.env.local` and adjust:
#   cp apps/web/.env.example apps/web/.env.local
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time, so they
# must never contain secrets and must be set before `next build`.
# -----------------------------------------------------------------------------

# Origin of the CalmCash API — no trailing slash and no `/api/v1`
# (the API client appends the version prefix itself).
#
# The session cookie is SameSite=Strict, so the web app and the API must be on the
# same site: `localhost:3000` + `localhost:4000` locally, or e.g.
# `app.calmcash.example` + `api.calmcash.example` in production. Mixing
# `localhost` and `127.0.0.1` makes them different sites and sign-in will not stick.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Vercel Services and `vercel dev` use same-origin `/api/v1` requests automatically.
# No public API URL or private service binding URL is needed in Vercel's environment settings.

# Service worker (installable app): on by default in production builds, never in `next dev`.
# Set to `off` and redeploy to unregister it from every browser (emergency kill switch).
# NEXT_PUBLIC_SERVICE_WORKER=off

# Version announced to open tabs after a deployment (service-worker update check). Vercel uses its
# deployment ID automatically; CI and containers may pass any value that changes per release.
# APP_VERSION=


{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@calmcash/web",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    // ES2023.Intl: exact decimal-string formatting in Intl.NumberFormat (money never uses floats).
    "lib": ["DOM", "DOM.Iterable", "ES2022", "ES2023.Intl"],
    "types": ["node"],
    "jsx": "react-jsx",
    "allowJs": false,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "vitest.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
